{
  "manifest_version": 3,
  "name": "Screen Capture & Blur Studio",
  "version": "1.0.1",
  "description": "画面の表示領域や指定範囲をキャプチャし、サイドパネルで全体ぼかし・部分ぼかし・モザイク・各種フィルターを編集できる拡張機能です。",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "storage",
    "downloads",
    "contextMenus",
    "alarms"
  ],
  "optional_host_permissions": [
    "file:///*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Screen Capture & Blur Studio を開く",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}